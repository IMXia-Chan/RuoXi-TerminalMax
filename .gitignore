pc-server/secret.json
pc-server/master.json

# 运行日志(含配对码、IP、遥测)
*.log
pc-server/server.log

# ---- 签名密钥(分发用,绝不入库) ----
*.jks
*.keystore
keystore.properties

# ---- 本地调试/诊断产物 ----
phone_log.txt
screen.png
pc-server/phone_logcat*.txt
pc-server/_diag_*
pc-server/_test_vcam.py
pc-server/_read_lnk.ps1

# ---- 本机专用启动/调试脚本(含绝对路径,不入库) ----
pc-server/start_background.bat
pc-server/media_panel.bat
pc-server/phone_mimic.py
