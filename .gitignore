# ---- Android / Gradle 构建产物 ----
*.iml
.gradle/
.idea/
.kotlin/
build/
local.properties
.DS_Store
captures/
.externalNativeBuild/
.cxx/

# ---- Python ----
__pycache__/
*.pyc
dist/
*.spec

# ---- 敏感/运行时生成,绝不入库 ----
