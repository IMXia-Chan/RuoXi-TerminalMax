<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Touchpad" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:buttonStyle">@style/Widget.Touchpad.Button</item>
    </style>

    <style name="Widget.Touchpad.Button" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/btn_accent</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
