<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Touchpad" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:buttonStyle">@style/Widget.Touchpad.Button</item>
    </style>

    <style name="Widget.Touchpad.Button" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/btn_accent</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 开屏动画:纯黑底,首帧前不闪出任何栏/色。
         windowSplashScreen* 是 Android 12+ 系统开屏(首帧前那个带图标的画面),这里把背景压成
         纯黑、图标换成全透明,省得进 app 时把桌面图标闪出来。API<31 的机型不认识这些属性,
         自动忽略,不影响。 -->
    <style name="Theme.Touchpad.Splash" parent="Theme.Touchpad">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_system_icon_blank</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
