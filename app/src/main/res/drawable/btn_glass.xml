<?xml version="1.0" encoding="utf-8"?>
<!-- 透明白色毛玻璃按钮:半透明白圆角,盖在镜像/任何背景上呈磨砂感。
     按压更实一点,禁用变淡;配深色文字(glass_text)保证可读。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#59FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#CCFFFFFF" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#8CFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#A6FFFFFF" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#52FFFFFF" />
        </shape>
    </item>
</selector>
